generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TECH
  OFFICE
  HOME
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   // Hash generado por bcrypt
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Item {
  id          String   @id @default(uuid())
  title       String
  price       Float
  category    Category
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("items")
}